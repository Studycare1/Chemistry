    // ============================================================
    // RENDER
    // ============================================================
    const mcqContainer = document.getElementById('mcq-container');
    mcqData.forEach(item => {
        const card = document.createElement('div');
        card.className = 'question-card';
        let opts = '';
        for (const [k, v] of Object.entries(item.options)) {
            opts += `<div class="option-btn" id="opt-${item.id}-${k}" onclick="selectOption(${item.id}, '${k}', '${item.ans}')"><strong>(${k})</strong>&nbsp; ${v}</div>`;
        }
        card.innerHTML = `<div class="question-text">${item.id}. ${item.q}</div><div class="options">${opts}</div><div class="reason-box" id="reason-${item.id}"><strong>Reason:</strong> ${item.reason}</div>`;
        mcqContainer.appendChild(card);
    });

    shortAnsData.forEach(item => {
        const c = document.createElement('div');
        c.className = 'ans-card';
        c.innerHTML = `<strong>Q${item.id}: ${item.q}</strong><div class="ans-text">${item.a}</div>`;
        document.getElementById('short-ans-container').appendChild(c);
    });
    longAnsData.forEach(item => {
        const c = document.createElement('div');
        c.className = 'ans-card';
        c.innerHTML = `<strong>Q${item.id}: ${item.q}</strong><div class="ans-text">${item.a}</div>`;
        document.getElementById('long-ans-container').appendChild(c);
    });

    // ============================================================
    // SELECT OPTION
    // ============================================================
    function selectOption(qId, selectedOpt, correctOpt) {
        if (isSubmitted) return;
        if (userAnswers[qId]) {
            document.getElementById(`opt-${qId}-${userAnswers[qId]}`).classList.remove('selected-ans');
        } else {
            attemptedQuestions.add(qId);
        }
        userAnswers[qId] = selectedOpt;
        document.getElementById(`opt-${qId}-${selectedOpt}`).classList.add('selected-ans');

        const isCorrect = selectedOpt === correctOpt;
        const log = { qId, selected: selectedOpt, correct: correctOpt, isCorrect, timeIST: nowIST(), ts: Date.now() };
        sessionRef.child('clicks').push(log).catch(() => {});
        sessionRef.update({ attempted: attemptedQuestions.size }).catch(() => {});
    }

    // ============================================================
    // SUBMIT — instant UI, async Firebase (doesn't block)
    // ============================================================
    function submitTest() {
        if (isSubmitted) return;
        isSubmitted = true;

        let correctCount = 0;
        mcqData.forEach(item => {
            const userAns = userAnswers[item.id];
            const selEl = userAns ? document.getElementById(`opt-${item.id}-${userAns}`) : null;
            const corEl = document.getElementById(`opt-${item.id}-${item.ans}`);
            const reasonEl = document.getElementById(`reason-${item.id}`);

            if (userAns) {
                if (userAns === item.ans) {
                    correctCount++;
                    selEl.classList.remove('selected-ans');
                    selEl.classList.add('correct-ans');
                } else {
                    selEl.classList.remove('selected-ans');
                    selEl.classList.add('incorrect-ans');
                    corEl.classList.add('correct-ans');
                }
            } else {
                corEl.classList.add('correct-ans');
            }
            reasonEl.style.display = 'block';
        });

        score = correctCount;
        lockTest();

        const totalQ      = mcqData.length;
        const attempted   = attemptedQuestions.size;
        const wrong       = attempted - score;
        const skipped     = totalQ - attempted;
        const durationSec = Math.round((Date.now() - startTime) / 1000);

        // ===== UI UPDATE (INSTANT — synchronous) =====
        document.getElementById('attempted-display').innerText = attempted;
        document.getElementById('score-display').innerText = score;
        document.getElementById('wrong-display').innerText = wrong;
        document.getElementById('skipped-display').innerText = skipped;
        document.getElementById('marks-display').innerText = score;
        document.getElementById('time-item').style.display = '';
        document.getElementById('time-display').innerText = durationStr(durationSec);
        document.getElementById('results').style.display = 'block';

        showAnswerReview(); // builds review list synchronously, no auto-scroll

        const btn = document.getElementById('submit-btn');
        btn.innerText = '✅ Test Submitted';
        btn.disabled = true;

        // Scroll to results (score visible first)
        setTimeout(() => {
            document.getElementById('results').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 50);

        // ===== FIREBASE (async — doesn't block UI) =====
        sessionRef.update({
            submitted: true, submitTime: nowIST(), submitTimestamp: Date.now(),
            durationSeconds: durationSec, durationStr: durationStr(durationSec),
            score, attempted, wrong, skipped
        }).catch(() => {});
        deviceRef.child('submitCount').transaction(v => (v || 0) + 1);
        deviceRef.child('bestScore').transaction(v => Math.max(v || 0, score));
        deviceRef.child('lastScore').set(score);
        deviceRef.child('scoreHistory').push({ score, total: totalQ, time: nowIST() });
    }

    function lockTest() {
        mcqData.forEach(item => {
            for (const k in item.options) {
                document.getElementById(`opt-${item.id}-${k}`).style.pointerEvents = 'none';
            }
        });
    }

    function showAnswerReview() {
        const list = document.getElementById('review-list');
        list.innerHTML = '';
        mcqData.forEach(item => {
            const userAns = userAnswers[item.id] || null;
            const status = userAns === null ? 'skipped' : (userAns === item.ans ? 'correct' : 'wrong');
            const badge = { correct: 'Correct ✓', wrong: 'Wrong ✗', skipped: 'Skipped —' }[status];

            let optsHTML = '';
            for (const [k, v] of Object.entries(item.options)) {
                let cls = 'review-opt';
                const isUser = k === userAns;
                const isCorrect = k === item.ans;
                if (isCorrect) cls += ' correct-answer';
                else if (isUser) cls += ' user-wrong';
                let tags = '';
                if (isUser) tags += ' <b>← Your Answer</b>';
                if (isCorrect && !isUser) tags += ' <b>(Correct)</b>';
                optsHTML += `<div class="${cls}"><b>(${k})</b> ${v}${tags}</div>`;
            }

            const card = document.createElement('div');
            card.className = `review-card ${status}`;
            card.innerHTML = `
                <div class="review-q">${item.id}. ${item.q} <span class="status-badge status-${status}">${badge}</span></div>
                ${optsHTML}
                <div class="review-reason"><b>Reason:</b> ${item.reason}</div>
            `;
            list.appendChild(card);
        });
        document.getElementById('answer-review').style.display = 'block';
        // NO auto-scroll here (submitTest handles scroll)
    }

    // ============================================================
    // CLICK HANDLER — 350ms submit delay (instant-feel) + 4-click admin
    // ============================================================
    let clickCount = 0, clickTimer = null;
    function handleSubmitClick() {
        clickCount++;
        clearTimeout(clickTimer);

        if (clickCount >= 4) {
            clickCount = 0;
            adminAccess();
            return;
        }

        clickTimer = setTimeout(() => {
            if (!isSubmitted) submitTest();
            clickCount = 0;
        }, 350);
    }
    document.getElementById('submit-btn').addEventListener('click', handleSubmitClick);

    // ============================================================
    // #admin URL / ?admin=1 access
    // ============================================================
    if (location.hash === '#admin' || location.search.includes('admin=1')) {
        setTimeout(adminAccess, 600);
    }
    window.addEventListener('hashchange', () => {
        if (location.hash === '#admin') adminAccess();
    });

    // ============================================================
    // ADMIN
    // ============================================================
    function adminAccess() {
        document.getElementById('admin-panel').style.display = 'block';
        document.getElementById('admin-panel').scrollIntoView({ behavior: 'smooth' });
        renderDeviceInfoBox();
        refreshAdmin(false);
    }

    function refreshAdmin(force) {
        if (adminListener) {
            try { database.ref('devices').off('value', adminListener); } catch(e) {}
        }
        const cb = snapshot => {
            allDevicesCache = [];
            snapshot.forEach(child => allDevicesCache.push({ key: child.key, ...child.val() }));
            renderAdminTable();
            const el = document.getElementById('admin-last-update');
            if (el) el.textContent = '🕐 Last refreshed: ' + nowIST();
        };
        adminListener = database.ref('devices').on('value', cb, err => {
            console.warn('Admin listener error:', err);
            const el = document.getElementById('admin-last-update');
            if (el) el.textContent = '⚠️ Read error: ' + (err.message || err);
        });
        if (force) {
            database.ref('devices').once('value').then(snap => {
                allDevicesCache = [];
                snap.forEach(child => allDevicesCache.push({ key: child.key, ...child.val() }));
                renderAdminTable();
                const el = document.getElementById('admin-last-update');
                if (el) el.textContent = '🕐 Refreshed at: ' + nowIST();
            }).catch(e => console.warn('once failed:', e));
        }
    }

    function isDeviceOnline(d) {
        return d.info && d.info.online && (Date.now() - (d.info.lastSeenTs || 0) < 5 * 60 * 1000);
    }

    function renderAdminTable() {
        let totalVisits = 0, totalSubmits = 0, bestScore = 0, activeCount = 0;
        allDevicesCache.forEach(d => {
            totalVisits += d.visitCount || 0;
            totalSubmits += d.submitCount || 0;
            bestScore = Math.max(bestScore, d.bestScore || 0);
            if (isDeviceOnline(d)) activeCount++;
        });
        document.getElementById('adm-devices').innerText = allDevicesCache.length;
        document.getElementById('adm-active').innerText = activeCount;
        document.getElementById('adm-visits').innerText = totalVisits;
        document.getElementById('adm-submits').innerText = totalSubmits;
        document.getElementById('adm-best').innerText = bestScore;

        const sorted = [...allDevicesCache].sort((a, b) => {
            const aOn = isDeviceOnline(a) ? 1 : 0, bOn = isDeviceOnline(b) ? 1 : 0;
            if (bOn !== aOn) return bOn - aOn;
            return (b.submitCount || 0) - (a.submitCount || 0);
        });
        const tbody = document.getElementById('admin-device-body');
        tbody.innerHTML = '';
        if (sorted.length === 0) {
            tbody.innerHTML = '<tr><td colspan="9" style="color:#94a3b8; padding:30px;">No devices yet. Share this page to see data here.</td></tr>';
            return;
        }
        sorted.forEach((d, i) => {
            const tr = document.createElement('tr');
            tr.className = 'rank-row';
            if (d.key === deviceId) tr.classList.add('is-current');
            tr.onclick = () => openDeviceModal(d);
            const online = isDeviceOnline(d);
            tr.innerHTML = `
                <td>${i + 1}</td>
                <td><code>${d.key}</code></td>
                <td><span class="online-dot ${online ? 'online-yes' : 'online-no'}"></span>${online ? 'Live' : '—'}</td>
                <td>${d.visitCount || 0}</td>
                <td>${d.submitCount || 0}</td>
                <td>${d.bestScore || 0}</td>
                <td>${d.lastScore !== undefined ? d.lastScore : '-'}</td>
                <td>${d.info?.location || 'Unknown'}</td>
                <td>${d.info?.lastSeen || '-'}</td>
            `;
            tbody.appendChild(tr);
        });
    }

    function openDeviceModal(device) {
        document.getElementById('modal-title').innerText = 'Device: ' + device.key;
        const info = device.info || {};

        let sessionsHTML = '<p>No sessions recorded.</p>';
        if (device.sessions) {
            const sessions = Object.values(device.sessions)
                .sort((a, b) => (b.startTimestamp || 0) - (a.startTimestamp || 0));
            sessionsHTML = sessions.map((s, i) => {
                const clicks = s.clicks ? Object.values(s.clicks) : [];
                const clicksHTML = clicks.length
                    ? clicks.map(c => `<div class="${c.isCorrect ? 'ok' : 'fail'}">Q${c.qId} → (${c.selected}) ${c.isCorrect ? '✓' : '✗ correct:' + c.correct} @ ${c.timeIST}</div>`).join('')
                    : '<div>No clicks</div>';
                return `
                    <div class="session-card">
                        <h4>Session #${sessions.length - i} — ${s.sessionId}</h4>
                        <div class="session-details">
                            <div><b>Started:</b> ${s.startTime || '-'}</div>
                            <div><b>Submitted:</b> ${s.submitted ? (s.submitTime || 'Yes') : '❌ Not submitted'}</div>
                            <div><b>Duration:</b> ${s.durationStr || '-'}</div>
                            <div><b>Score:</b> ${s.score || 0}/70</div>
                            <div><b>Attempted:</b> ${s.attempted || 0}</div>
                            <div><b>Wrong:</b> ${s.wrong || 0}</div>
                            <div><b>Skipped:</b> ${s.skipped !== undefined ? s.skipped : (70 - (s.attempted || 0))}</div>
                        </div>
                        <div><b>Click Log (${clicks.length}):</b></div>
                        <div class="click-log">${clicksHTML}</div>
                    </div>
                `;
            }).join('');
        }

        document.getElementById('modal-body').innerHTML = `
            <div class="info-grid">
                <p><b>Device ID:</b> ${device.key}</p>
                <p><b>Total Visits:</b> ${device.visitCount || 0}</p>
                <p><b>Total Submits:</b> ${device.submitCount || 0}</p>
                <p><b>Best Score:</b> ${device.bestScore || 0}/70</p>
                <p><b>Last Score:</b> ${device.lastScore !== undefined ? device.lastScore + '/70' : '-'}</p>
                <p><b>First Seen:</b> ${info.firstSeen || '-'}</p>
                <p><b>Last Seen:</b> ${info.lastSeen || '-'}</p>
                <p><b>Status:</b> ${isDeviceOnline(device) ? '🟢 Online' : '⚪ Offline'}</p>
                <p><b>IP:</b> ${info.ip || 'N/A'}</p>
                <p><b>Location:</b> ${info.location || 'N/A'}</p>
                <p><b>Device:</b> ${info.device || 'N/A'}</p>
                <p><b>OS:</b> ${info.os || 'N/A'}</p>
            </div>
            <hr>
            <h3>All Sessions (${device.sessions ? Object.keys(device.sessions).length : 0})</h3>
            ${sessionsHTML}
        `;
        document.getElementById('userModal').style.display = 'flex';
    }

    function closeModal() {
        document.getElementById('userModal').style.display = 'none';
    }
    window.onclick = e => {
        if (e.target === document.getElementById('userModal')) closeModal();
    };

    // Best-effort online=false on tab close
    window.addEventListener('beforeunload', () => {
        try {
            const url = `${DB_BASE}/devices/${deviceId}/info/online.json`;
            navigator.sendBeacon && navigator.sendBeacon(url, JSON.stringify(false));
        } catch(e) {}
    });
</script>
</body>
</html>
