<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chemistry Model Paper - StudyCare</title>
    <style>
        :root { --primary: #2c3e50; --secondary: #34495e; --correct: #2ecc71; --incorrect: #e74c3c; --skipped: #95a5a6; --bg: #f4f7f6; --card-bg: #ffffff; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: var(--bg); color: #333; line-height: 1.6; margin: 0; padding: 20px; }
        .container { max-width: 1100px; margin: 0 auto; background: var(--card-bg); padding: 30px; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        h1, h2, h3 { text-align: center; color: var(--primary); }
        .header-info { text-align: center; font-weight: bold; margin-bottom: 20px; color: var(--secondary); }
        .question-card { background: #fafafa; border: 1px solid #ddd; border-radius: 8px; padding: 15px 20px; margin-bottom: 20px; }
        .question-text { font-weight: 600; margin-bottom: 15px; font-size: 16px; }
        .options { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        @media (max-width: 600px) { .options { grid-template-columns: 1fr; } }
        .option-btn { display: flex; align-items: center; cursor: pointer; padding: 10px 15px; border-radius: 5px; border: 1px solid #ccc; background: white; font-size: 15px; transition: all 0.2s; }
        .option-btn:hover { background: #e9ecef; }
        .option-btn.selected-ans { background-color: #e0e7ff !important; border: 2px solid #6366f1; color: #3730a3; font-weight: bold; }
        .option-btn.correct-ans { background-color: #d4edda !important; border: 2px solid var(--correct); color: #155724; font-weight: bold; }
        .option-btn.incorrect-ans { background-color: #f8d7da !important; border: 2px solid var(--incorrect); color: #721c24; font-weight: bold; }
        .reason-box { display: none; margin-top: 15px; padding: 10px; background: #fff3cd; border-left: 4px solid #ffc107; border-radius: 4px; font-size: 14px; color: #856404; }
        .btn-container { display: flex; justify-content: center; gap: 20px; margin-top: 30px; margin-bottom: 20px; flex-wrap: wrap; }
        button { padding: 12px 25px; font-size: 16px; font-weight: bold; border: none; border-radius: 5px; cursor: pointer; }
        .btn-submit { background-color: var(--primary); color: white; }
        .btn-submit:disabled { background-color: #95a5a6; cursor: not-allowed; }
        #results { text-align: center; margin-top: 20px; padding: 20px; background: #e8f4f8; border-radius: 8px; border-left: 5px solid var(--primary); }
        .result-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; max-width: 650px; margin: 15px auto 0; }
        @media (max-width: 600px) { .result-grid { grid-template-columns: repeat(2, 1fr); } }
        .rg-item { background: white; padding: 10px; border-radius: 6px; }
        .rg-label { font-size: 11px; color: #666; text-transform: uppercase; letter-spacing: 0.5px; }
        .rg-value { font-size: 22px; font-weight: bold; color: var(--primary); }
        .rg-item.highlight { background: var(--primary); }
        .rg-item.highlight .rg-label { color: #bdc3c7; }
        .rg-item.highlight .rg-value { color: white; }
        #answer-review { display: none; margin-top: 30px; padding: 20px; background: #fdfdfd; border-radius: 8px; border: 2px solid var(--primary); }
        .review-card { background: white; border-radius: 8px; padding: 15px; margin-bottom: 15px; border-left: 5px solid #ccc; }
        .review-card.correct { border-left-color: var(--correct); }
        .review-card.wrong { border-left-color: var(--incorrect); }
        .review-card.skipped { border-left-color: var(--skipped); }
        .review-q { font-weight: bold; margin-bottom: 10px; }
        .review-opt { padding: 8px 12px; margin: 5px 0; border-radius: 5px; font-size: 14px; background: #f5f5f5; }
        .review-opt.user-wrong { background: #f8d7da; border: 1px solid var(--incorrect); }
        .review-opt.correct-answer { background: #d4edda; border: 2px solid var(--correct); font-weight: bold; }
        .review-reason { margin-top: 10px; padding: 10px; background: #fff3cd; border-left: 3px solid #ffc107; font-size: 13px; border-radius: 4px; }
        .status-badge { display: inline-block; padding: 3px 12px; border-radius: 12px; font-size: 12px; font-weight: bold; color: white; margin-left: 8px; }
        .status-correct { background: var(--correct); }
        .status-wrong { background: var(--incorrect); }
        .status-skipped { background: var(--skipped); }
        #admin-panel { display: none; margin-top: 30px; padding: 20px; background: #fff; border-radius: 8px; border: 2px solid #e74c3c; }
        #admin-panel h2 { color: #e74c3c; }
        .admin-controls { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; align-items: center; margin-bottom: 20px; }
        .admin-controls button { padding: 8px 18px; font-size: 14px; }
        .conn-status { display: inline-block; padding: 5px 14px; border-radius: 20px; font-size: 12px; font-weight: 700; }
        .conn-online { background: #10b981; color: white; }
        .conn-offline { background: #ef4444; color: white; }
        .admin-stats { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; margin: 20px 0; }
        @media (max-width: 700px) { .admin-stats { grid-template-columns: repeat(2, 1fr); } }
        .admin-stat { background: #ecf0f1; padding: 15px; border-radius: 8px; text-align: center; }
        .admin-stat .num { font-size: 24px; font-weight: bold; color: var(--primary); }
        .admin-stat .lbl { font-size: 11px; color: #666; text-transform: uppercase; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; background: white; font-size: 12px; }
        th, td { padding: 8px; text-align: center; border-bottom: 1px solid #ddd; }
        th { background-color: var(--primary); color: white; }
        .rank-row { cursor: pointer; }
        .rank-row:hover { background-color: #e2e8f0 !important; }
        .rank-row.is-current { background-color: #d4edda; }
        .online-dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 4px; vertical-align: middle; }
        .online-yes { background: #10b981; box-shadow: 0 0 6px #10b981; }
        .online-no { background: #64748b; }
        #admin-last-update { font-size: 12px; color: #94a3b8; text-align: center; margin-top: 10px; }
        .modal { display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; overflow: auto; background-color: rgba(0,0,0,0.6); align-items: center; justify-content: center; }
        .modal-content { background-color: #fefefe; margin: auto; padding: 20px; border: 1px solid #888; width: 90%; max-width: 750px; border-radius: 10px; position: relative; max-height: 85vh; overflow-y: auto; }
        .close-btn { color: #aaa; float: right; font-size: 28px; font-weight: bold; cursor: pointer; }
        .close-btn:hover { color: black; }
        .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 15px; margin-bottom: 15px; }
        @media (max-width: 600px) { .info-grid { grid-template-columns: 1fr; } }
        .info-grid p { margin: 4px 0; font-size: 14px; }
        .info-grid b { color: var(--primary); }
        .session-card { background: white; border-left: 4px solid var(--secondary); padding: 12px; margin: 12px 0; border-radius: 5px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .session-card h4 { margin: 0 0 10px 0; color: var(--primary); font-size: 14px; }
        .session-details { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 8px; font-size: 12px; margin-bottom: 10px; }
        .session-details div { background: #f0f3f5; padding: 6px 8px; border-radius: 3px; }
        .session-details b { color: var(--secondary); }
        .click-log { max-height: 200px; overflow-y: auto; margin-top: 10px; font-size: 11px; background: #f8f9fa; padding: 8px; border-radius: 4px; }
        .click-log div { padding: 3px 6px; border-bottom: 1px solid #eee; font-family: monospace; }
        .click-log .ok { color: #27ae60; }
        .click-log .fail { color: #e74c3c; }
        #section-b { margin-top: 40px; border-top: 2px dashed #ccc; padding-top: 20px; }
        .ans-card { background: #fdfdfd; border-left: 5px solid var(--secondary); padding: 15px; margin-bottom: 15px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .ans-text { color: #444; margin-top: 10px; white-space: pre-wrap; font-size: 15px; }
        .device-info { font-size: 13px; color: #333; margin-top: 10px; background: #e8f4f8; padding: 15px; border-radius: 5px; border: 1px solid #bce8f1; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        @media (max-width: 600px) { .device-info { grid-template-columns: 1fr; } }
        .device-info b { color: var(--primary); }
    </style>
    <script src="https://www.gstatic.com/firebasejs/9.22.2/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.2/firebase-database-compat.js"></script>
</head>
<body>
<div class="container">
    <h1>CHEMISTRY MODEL PAPER - 1</h1>
    <div class="header-info">Time: 3 Hours + 15 Minutes | Total Marks: 70</div>

    <h2>SECTION - A : Objective Type Questions</h2>
    <div id="mcq-container"></div>

    <div id="results" style="display:none;">
        <h3 style="margin-top:0;">📊 Your Score</h3>
        <div class="result-grid">
            <div class="rg-item"><div class="rg-label">Attempted</div><div class="rg-value"><span id="attempted-display">0</span>/70</div></div>
            <div class="rg-item"><div class="rg-label">Correct</div><div class="rg-value" style="color:var(--correct);" id="score-display">0</div></div>
            <div class="rg-item"><div class="rg-label">Wrong</div><div class="rg-value" style="color:var(--incorrect);" id="wrong-display">0</div></div>
            <div class="rg-item"><div class="rg-label">Skipped</div><div class="rg-value" id="skipped-display">70</div></div>
            <div class="rg-item highlight"><div class="rg-label">Marks Obtained</div><div class="rg-value"><span id="marks-display">0</span>/70</div></div>
            <div class="rg-item" id="time-item" style="display:none;"><div class="rg-label">Time Taken</div><div class="rg-value" id="time-display" style="font-size:16px;">-</div></div>
        </div>
    </div>

    <div class="btn-container">
        <button type="button" id="submit-btn" class="btn-submit">Finish Test</button>
    </div>

    <div id="answer-review">
        <h2>📋 Answer Review Sheet</h2>
        <p style="text-align:center; color:#666; margin-top:-10px;">Detailed analysis of all 70 questions</p>
        <div id="review-list"></div>
    </div>

    <div id="admin-panel">
        <h2>🔒 Admin Dashboard</h2>
        <div class="admin-controls">
            <span id="fb-connection-status" class="conn-status conn-offline">⚫ Connecting…</span>
            <button onclick="refreshAdmin(true)" style="background:#2ecc71; color:white;">🔄 Refresh Now</button>
            <button onclick="document.getElementById('admin-panel').style.display='none'" style="background:#95a5a6; color:white;">Close Admin</button>
        </div>

        <h3 style="text-align:left; font-size:16px; margin-top:20px;">Your Current Device Info:</h3>
        <div id="user-device-info" class="device-info"></div>

        <div class="admin-stats">
            <div class="admin-stat"><div class="num" id="adm-devices">0</div><div class="lbl">Total Devices</div></div>
            <div class="admin-stat"><div class="num" id="adm-active">0</div><div class="lbl">Active (5m)</div></div>
            <div class="admin-stat"><div class="num" id="adm-visits">0</div><div class="lbl">Total Visits</div></div>
            <div class="admin-stat"><div class="num" id="adm-submits">0</div><div class="lbl">Total Submits</div></div>
            <div class="admin-stat"><div class="num" id="adm-best">0</div><div class="lbl">Highest Score</div></div>
        </div>
        <div style="overflow-x:auto;">
            <table>
                <thead>
                    <tr><th>#</th><th>Device ID</th><th>Live</th><th>Visits</th><th>Submits</th><th>Best</th><th>Last</th><th>Location</th><th>Last Seen (IST)</th></tr>
                </thead>
                <tbody id="admin-device-body"></tbody>
            </table>
        </div>
        <div id="admin-last-update"></div>
    </div>

    <div id="section-b">
        <h2>SECTION - B : Non-Objective Type Questions</h2>
        <div id="short-ans-container"><h3>Short Answer Type Questions</h3></div>
        <div id="long-ans-container"><h3>Long Answer Type Questions</h3></div>
    </div>
</div>

<div id="userModal" class="modal">
    <div class="modal-content">
        <span class="close-btn" onclick="closeModal()">&times;</span>
        <h2 id="modal-title">Device Details</h2>
        <div id="modal-body" class="modal-body-content"></div>
    </div>
</div>

<script>
    // ============================================================
    // FIREBASE
    // ============================================================
    const firebaseConfig = {
        apiKey: "AIzaSyB6P7OJz58DEMvtQqe49EArG1TMoE4l0yk",
        authDomain: "studycare-chemistry.firebaseapp.com",
        databaseURL: "https://studycare-chemistry-default-rtdb.firebaseio.com",
        projectId: "studycare-chemistry",
        storageBucket: "studycare-chemistry.firebasestorage.app",
        messagingSenderId: "693936311195",
        appId: "1:693936311195:web:648b62c1f17b3872ffef3e",
        measurementId: "G-2JWH252291"
    };
    firebase.initializeApp(firebaseConfig);
    const database = firebase.database();
    const DB_BASE = firebaseConfig.databaseURL;

    // ============================================================
    // HELPERS
    // ============================================================
    function nowIST() {
        return new Date().toLocaleString('en-IN', {
            timeZone: 'Asia/Kolkata', year: 'numeric', month: '2-digit', day: '2-digit',
            hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true
        });
    }
    function durationStr(sec) {
        const m = Math.floor(sec / 60), s = sec % 60;
        return `${m}m ${s}s`;
    }
    function withTimeout(promise, ms) {
        return Promise.race([promise, new Promise((_, rej) => setTimeout(() => rej(new Error('timeout')), ms))]);
    }

    // ============================================================
    // DEVICE ID (unique per browser, with fallbacks)
    // ============================================================
    function getDeviceId() {
        let id = null;
        try { id = localStorage.getItem('sc_chem_device_id'); } catch(e) {}
        if (!id) { try { id = sessionStorage.getItem('sc_chem_device_id'); } catch(e) {} }
        if (!id) {
            const m = document.cookie.match(/(?:^|;\s*)sc_chem_device_id=([^;]+)/);
            if (m) id = decodeURIComponent(m[1]);
        }
        if (!id) {
            const fp = [navigator.userAgent, navigator.language, navigator.platform,
                navigator.hardwareConcurrency || 0, new Date().getTimezoneOffset(),
                screen.colorDepth, screen.width + 'x' + screen.height].join('|');
            let hash = 0;
            for (let i = 0; i < fp.length; i++) hash = ((hash << 5) - hash + fp.charCodeAt(i)) | 0;
            const rand = Math.random().toString(36).slice(2, 8).toUpperCase();
            const ts = Date.now().toString(36).toUpperCase().slice(-4);
            id = 'CHM_' + Math.abs(hash).toString(36).toUpperCase() + '_' + rand + ts;
            try { localStorage.setItem('sc_chem_device_id', id); } catch(e) {}
            try { sessionStorage.setItem('sc_chem_device_id', id); } catch(e) {}
            try { document.cookie = 'sc_chem_device_id=' + encodeURIComponent(id) + '; max-age=31536000; path=/; SameSite=Lax'; } catch(e) {}
        }
        return id;
    }
    const deviceId  = getDeviceId();
    const sessionId = 'sess_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7);
    const deviceRef  = database.ref('devices/' + deviceId);
    const sessionRef = database.ref('devices/' + deviceId + '/sessions/' + sessionId);
    const infoRef    = deviceRef.child('info');

    // ============================================================
    // STATE
    // ============================================================
    const startTime = new Date();
    let isSubmitted = false;
    let score = 0;
    const attemptedQuestions = new Set();
    const userAnswers = {};
    let userIP = "Pending", userLocation = "Unknown", deviceDetails = "Unknown Device";
    let adminListener = null, allDevicesCache = [];
    let isFirebaseConnected = false;
    let lastRestFallback = 0;

    // ============================================================
    // REST FALLBACK (Opera Mini / WebSocket-blocked)
    // ============================================================
    function restFallback(pathSuffix, data) {
        const now = Date.now();
        if (now - lastRestFallback < 8000) return;
        lastRestFallback = now;
        const url = `${DB_BASE}/devices/${deviceId}${pathSuffix}.json`;
        fetch(url, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        }).then(() => console.log('✅ REST fallback OK'))
          .catch(e => console.warn('REST fallback failed:', e));
    }

    // ============================================================
    // updateDeviceMeta — IMMEDIATE call on page load
    // ============================================================
    function updateDeviceMeta(extra = {}) {
        const data = {
            deviceId, ip: userIP, location: userLocation, device: deviceDetails,
            os: navigator.platform || 'Unknown', ua: navigator.userAgent,
            lastSeen: nowIST(), lastSeenTs: Date.now(), online: true,
            ...extra
        };
        infoRef.update(data).catch(err => {
            console.warn('SDK meta write failed → REST fallback', err);
            restFallback('/info', data);
        });
        return data;
    }
    updateDeviceMeta(); // ← IMMEDIATE

    // ============================================================
    // VISIT + SESSION TRACKING
    // ============================================================
    deviceRef.child('visitCount').transaction(v => (v || 0) + 1, (err) => { if (err) console.warn('visitCount tx:', err); });
    deviceRef.child('info/firstSeen').transaction(v => v || nowIST());
    deviceRef.child('info/online').onDisconnect().set(false);

    sessionRef.set({
        sessionId, startTime: nowIST(), startTimestamp: Date.now(),
        submitted: false, score: 0, attempted: 0
    }).catch(err => {
        console.warn('Session write failed → REST', err);
        restFallback('/sessions/' + sessionId, { sessionId, startTime: nowIST(), startTimestamp: Date.now(), submitted: false, score: 0, attempted: 0 });
    });

    // Heartbeat
    setInterval(() => {
        if (!isSubmitted) updateDeviceMeta();
    }, 30000);

    // Retry REST if SDK still not connected after 8s
    setTimeout(() => {
        if (!isFirebaseConnected) {
            console.log('Firebase not connected → REST fallback');
            restFallback('/info', {
                deviceId, ip: userIP, location: userLocation, device: deviceDetails,
                os: navigator.platform || 'Unknown', ua: navigator.userAgent,
                lastSeen: nowIST(), lastSeenTs: Date.now(), online: true,
                source: 'rest_fallback'
            });
        }
    }, 8000);

    // ============================================================
    // IP + DEVICE INFO (non-blocking with timeout)
    // ============================================================
    withTimeout(fetch('https://ipapi.co/json/').then(r => r.json()), 5000)
        .then(d => {
            userIP = d.ip || "Hidden";
            userLocation = `${d.city || 'Unknown'}, ${d.country_name || 'Unknown'}`;
            updateDeviceMeta();
            renderDeviceInfoBox();
        })
        .catch(() => { userIP = "Blocked"; updateDeviceMeta(); });

    async function getDeviceInfo() {
        let info = [];
        try {
            if (navigator.userAgentData) {
                const h = await withTimeout(
                    navigator.userAgentData.getHighEntropyValues(["model", "platform", "platformVersion"]),
                    3000
                );
                if (h.model) info.push(h.model);
                if (h.platform) info.push(`${h.platform} ${h.platformVersion || ''}`.trim());
                const b = (navigator.userAgentData.brands || []).find(b => /Chrome|Edge/.test(b.brand));
                if (b) info.push(b.brand);
            }
        } catch (e) {}
        if (info.length === 0) {
            if (/Android/.test(navigator.userAgent)) info.push("Android");
            else if (/iPhone|iPad/.test(navigator.userAgent)) info.push("iOS");
            else if (/Windows/.test(navigator.userAgent)) info.push("Windows");
            else if (/Macintosh/.test(navigator.userAgent)) info.push("MacOS");
            else info.push("Unknown Device");
        }
        deviceDetails = info.join(" | ");
        renderDeviceInfoBox();
        updateDeviceMeta();
    }
    getDeviceInfo();

    // Firebase connection monitor
    database.ref('.info/connected').on('value', snap => {
        isFirebaseConnected = !!snap.val();
        const el = document.getElementById('fb-connection-status');
        if (el) {
            if (isFirebaseConnected) {
                el.className = 'conn-status conn-online';
                el.textContent = '🟢 Firebase Connected';
            } else {
                el.className = 'conn-status conn-offline';
                el.textContent = '🔴 Firebase Offline';
            }
        }
        renderDeviceInfoBox();
    });

    function renderDeviceInfoBox() {
        const el = document.getElementById('user-device-info');
        if (!el) return;
        el.innerHTML = `
            <div><b>🌐 Your IP:</b> ${userIP} (${userLocation})</div>
            <div><b>📱 Your Device:</b> ${deviceDetails}</div>
            <div><b>🆔 Your Device ID:</b> ${deviceId}</div>
            <div><b>🔗 Firebase:</b> ${isFirebaseConnected ? '🟢 Connected' : '🔴 Offline'}</div>
            <div><b>🕐 Current IST Time:</b> ${nowIST()}</div>
        `;
    }

    // ============================================================
    // 70 MCQs (unchanged)
    // ============================================================
    const mcqData = [
        { id: 1, q: "The solution which shows positive or negative deviation from Raoult's law is called :", options: { A: "Ideal solution", B: "True solution", C: "Non-ideal solution", D: "Colloidal solution" }, ans: "C", reason: "Non-ideal solutions show deviations from Raoult's law." },
        { id: 2, q: "Rust is :", options: { A: "Powdered iron", B: "Ferrous oxide", C: "Ferric oxide", D: "Hydrated ferric oxide" }, ans: "D", reason: "Rust is Fe₂O₃·xH₂O." },
        { id: 3, q: "The process of smelting involves reduction of metal oxide with :", options: { A: "Al", B: "C", C: "Mg", D: "S" }, ans: "B", reason: "Carbon (coke) is used." },
        { id: 4, q: "Which of the following has zero dipole moment ?", options: { A: "CH₃Cl", B: "CCl₄", C: "CH₂Cl₂", D: "CHCl₃" }, ans: "B", reason: "CCl₄ is symmetrical." },
        { id: 5, q: "Diethyl ether finds its use in medicine as :", options: { A: "pain killer", B: "hypnotic", C: "antiseptic", D: "anaesthetic" }, ans: "D", reason: "Used as anesthetic." },
        { id: 6, q: "Reaction of primary amine with chloroform in the presence of alcoholic KOH is called :", options: { A: "Hydrolysis", B: "Reduction", C: "Wurtz reaction", D: "Carbylamine reaction" }, ans: "D", reason: "Forms isocyanides." },
        { id: 7, q: "Which of the following is a disaccharide ?", options: { A: "Sucrose", B: "Glucose", C: "Fructose", D: "Starch" }, ans: "A", reason: "Sucrose = glucose + fructose." },
        { id: 8, q: "An ore having two different metal atoms is :", options: { A: "Haematite", B: "Galena", C: "Magnetite", D: "Copper pyrite" }, ans: "D", reason: "CuFeS₂ has Cu and Fe." },
        { id: 9, q: "Which of the following has maximum number of unpaired electrons ?", options: { A: "Mg²⁺", B: "Ti³⁺", C: "V³⁺", D: "Fe³⁺" }, ans: "D", reason: "Fe³⁺ is 3d⁵." },
