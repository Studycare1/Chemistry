        { id: 24, q: "Acetone + I2/NaOH & Acetylene + Cu-tube.", a: "Iodoform test & Benzene formation." },
        { id: 25, q: "DNA vs RNA.", a: "DNA: double, deoxyribose. RNA: single, ribose." },
