    const longAnsData = [
        { id: 21, q: "Physisorption vs Chemisorption.", a: "Physi: low enthalpy, reversible. Chemi: high enthalpy, irreversible." },
        { id: 22, q: "Kolbe's & Reimer-Tiemann.", a: "Phenol + CO2/CHCl3 + NaOH." },
